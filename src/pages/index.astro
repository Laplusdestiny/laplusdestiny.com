---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero, { type Stat } from '../components/Hero.astro';
import Works from '../components/Works.astro';
import Blog from '../components/Blog.astro';
import Skills from '../components/Skills.astro';
import Gallery from '../components/Gallery.astro';
import Links from '../components/Links.astro';
import Footer from '../components/Footer.astro';
import worksData from '../data/works.json';
import linksData from '../data/links.json';
import profile from '../data/profile.json';
import { aggregateLanguages, loadWorks } from '../lib/works';
import { parseGitHubRepoUrl } from '../lib/github';
import { countByQuarter, fetchPosts } from '../lib/blog';
import { formatDate } from '../lib/format';
import { BLOG_FEED_URL, GITHUB_TOKEN, SITE_URL } from '../config';

// ここで取得したデータはビルド時点のもの。定期的に再ビルドして最新にする（README 参照）
const builtAt = new Date();
const [works, posts] = await Promise.all([
  loadWorks(worksData.works, { githubToken: GITHUB_TOKEN }),
  fetchPosts(BLOG_FEED_URL),
]);
const quarters = countByQuarter(posts, builtAt);

// GitHub API の回数制限などで一部のリポジトリしか取れなかったときは、
// 偏った集計を見せないよう、言語グラフと関連する数値を出さない
const repoDataComplete = works.every((work) => !parseGitHubRepoUrl(work.url) || work.repo);
if (!repoDataComplete) console.warn('[github] 一部のリポジトリ情報を取得できなかったため、言語の集計を表示しません');
const languages = repoDataComplete ? aggregateLanguages(works) : [];
const languageCount = repoDataComplete
  ? new Set(works.flatMap((work) => Object.keys(work.repo?.languages ?? {}))).size
  : 0;
const lastPush = repoDataComplete
  ? works
      .map((work) => work.repo?.pushedAt)
      .filter((date): date is string => Boolean(date))
      .sort()
      .at(-1)
  : undefined;

const stats: Stat[] = [
  { label: '公開している作品', value: String(works.length), note: 'GitHub' },
  ...(posts.length > 0 ? [{ label: 'ブログ記事', value: String(posts.length), note: `最新 ${formatDate(posts[0].date)}` }] : []),
  ...(languageCount > 0 ? [{ label: '作品で使った言語', value: String(languageCount), note: `最多 ${languages[0].name}` }] : []),
  ...(lastPush ? [{ label: '最後のコード更新', value: formatDate(new Date(lastPush)), note: 'GitHub への push' }] : []),
];

const navItems = [
  { label: 'Works', href: '#works' },
  ...(posts.length > 0 ? [{ label: 'Blog', href: '#blog' }] : []),
  { label: 'Skills', href: '#skills' },
  { label: 'Photos', href: '#photos' },
  { label: 'Links', href: '#links' },
];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: SITE_URL,
  jobTitle: profile.roles.join(' / '),
  sameAs: linksData.links.map((link) => link.url),
};
---

<Layout>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <Header items={navItems} />
  <main id="main">
    <Hero stats={stats} />
    <Works works={works} languages={languages} />
    {posts.length > 0 && <Blog posts={posts} quarters={quarters} />}
    <Skills />
    <Gallery />
    <Links />
  </main>
  <Footer builtAt={builtAt} />
</Layout>
