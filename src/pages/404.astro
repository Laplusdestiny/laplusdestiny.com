---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ページが見つかりません | Laplusdestiny" noindex>
  <main id="main" class="mx-auto flex min-h-screen max-w-5xl flex-col justify-center px-5 sm:px-8">
    <p class="font-mono text-xs text-ink-3">404 · not found</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">ページが見つかりません</h1>
    <p class="mt-4 text-ink-2">URL が変わったか、削除された可能性があります。</p>
    <a href="/" class="link mt-8 w-fit text-sm">トップページへ戻る</a>
  </main>
</Layout>
