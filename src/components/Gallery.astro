---
import CloseIcon from '~icons/lucide/x';
import SectionHeading from './SectionHeading.astro';
import galleryData from '../data/gallery.json';
import { mapSequential, optimizeRemoteImage } from '../lib/image';

const photos = (
  await mapSequential(galleryData.photos, async (photo, index) => {
    // 一覧用の小さい画像と、拡大表示用の画像をビルド時に作る（元の写真より大きくはしない）
    const thumb = await optimizeRemoteImage(photo.url, { widths: [400, 800] });
    const full = await optimizeRemoteImage(photo.url, {});
    return thumb && full ? { ...photo, number: index + 1, thumb, full } : undefined;
  })
).filter((photo) => photo !== undefined);
---

{
  photos.length > 0 && (
    <section id="photos" aria-labelledby="photos-title" class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
      <SectionHeading id="photos-title" label="Photos" meta={`${photos.length} shots`} title="撮ったもの" />

      <ul class="grid gap-x-5 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {photos.map((photo) => (
          <li>
            <figure>
              <button
                type="button"
                class="group block w-full overflow-hidden rounded border border-line bg-card"
                data-photo-src={photo.full.src}
                data-photo-alt={photo.alt}
                aria-label={`「${photo.alt}」を拡大表示`}
              >
                <img
                  src={photo.thumb.src}
                  srcset={photo.thumb.srcset}
                  sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
                  width={photo.thumb.width}
                  height={photo.thumb.height}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
                />
              </button>
              <figcaption class="mt-2 font-mono text-xs text-ink-3">
                fig.{photo.number} — {photo.alt}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <dialog id="lightbox" class="lightbox m-auto max-h-none max-w-none bg-transparent p-0 text-white" aria-label="写真の拡大表示">
        <form method="dialog" class="fixed top-4 right-4">
          <button class="rounded-full bg-white/10 p-2 hover:bg-white/20" aria-label="閉じる">
            <CloseIcon class="h-6 w-6" aria-hidden="true" />
          </button>
        </form>
        <figure class="flex flex-col items-center gap-3">
          <img id="lightbox-image" src="" alt="" class="max-h-[85vh] max-w-[92vw] rounded object-contain" />
          <figcaption id="lightbox-caption" class="font-mono text-xs text-white/80" />
        </figure>
      </dialog>
    </section>
  )
}

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');

  document.querySelectorAll<HTMLButtonElement>('[data-photo-src]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !image) return;
      image.src = button.dataset.photoSrc ?? '';
      image.alt = button.dataset.photoAlt ?? '';
      if (caption) caption.textContent = button.dataset.photoAlt ?? '';
      dialog.showModal();
    });
  });

  // 写真の外側（背景）をクリックしたら閉じる
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
