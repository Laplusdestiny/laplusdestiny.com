---
import ArrowUpRightIcon from '~icons/lucide/arrow-up-right';
import StarIcon from '~icons/lucide/star';
import SectionHeading from './SectionHeading.astro';
import LanguageChart from './LanguageChart.astro';
import type { LanguageShare, Work } from '../lib/works';
import { mapSequential, optimizeRemoteImage } from '../lib/image';
import { displayUrl, formatDate } from '../lib/format';

interface Props {
  works: Work[];
  languages: LanguageShare[];
}

const { works, languages } = Astro.props;

const cards = await mapSequential(works, async (work) => ({
  ...work,
  host: new URL(work.url).hostname.replace(/^www\./, ''),
  thumbnail: work.image ? await optimizeRemoteImage(work.image, { widths: [480, 960] }) : undefined,
}));
---

<section id="works" aria-labelledby="works-title" class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
  <SectionHeading id="works-title" label="Works" meta={`${works.length} projects`} title="つくったもの">
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-2">
      GitHub で公開しているものから選んで載せています。説明と画像は各ページの情報をビルド時に読み込んでいます。
    </p>
  </SectionHeading>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((work) => (
        <li class="group relative flex flex-col overflow-hidden rounded border border-line bg-card transition-colors hover:border-ink-3">
          <div class="aspect-[2/1] overflow-hidden border-b border-line bg-paper">
            {work.thumbnail ? (
              <img
                src={work.thumbnail.src}
                srcset={work.thumbnail.srcset}
                sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
                width={work.thumbnail.width}
                height={work.thumbnail.height}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full items-center justify-center font-mono text-xs text-ink-3">{work.host}</div>
            )}
          </div>

          <div class="flex flex-1 flex-col p-4">
            <h3 class="font-semibold">
              {/* カード全体をクリックできるように、リンクの当たり判定をカードいっぱいに広げる */}
              <a href={work.url} class="after:absolute after:inset-0 group-hover:text-accent">
                {work.title}
              </a>
            </h3>
            {work.description && <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-2">{work.description}</p>}

            <dl class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-4 font-mono text-xs text-ink-3">
              {work.repo ? (
                <>
                  {work.repo.language && (
                    <div>
                      <dt class="sr-only">主な言語</dt>
                      <dd>{work.repo.language}</dd>
                    </div>
                  )}
                  <div class="flex items-center gap-1">
                    <dt>
                      <StarIcon class="h-3 w-3" aria-hidden="true" />
                      <span class="sr-only">スター</span>
                    </dt>
                    <dd>{work.repo.stars}</dd>
                  </div>
                  {work.repo.pushedAt && (
                    <div class="flex gap-1">
                      <dt>更新</dt>
                      <dd>{formatDate(new Date(work.repo.pushedAt))}</dd>
                    </div>
                  )}
                </>
              ) : (
                <div>
                  <dt class="sr-only">サイト</dt>
                  <dd>{work.host}</dd>
                </div>
              )}
            </dl>

            {work.repo?.homepage && (
              <a
                href={work.repo.homepage}
                class="relative z-10 mt-3 inline-flex w-fit items-center gap-0.5 text-xs text-ink-2 underline decoration-line underline-offset-4 hover:text-accent hover:decoration-accent"
              >
                {displayUrl(work.repo.homepage)}
                <ArrowUpRightIcon class="h-3 w-3" aria-hidden="true" />
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  {
    languages.length > 0 && (
      <div class="mt-14 max-w-xl">
        <LanguageChart rows={languages} />
      </div>
    )
  }
</section>
