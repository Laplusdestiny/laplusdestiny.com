---

<footer class="border-t border-surface-tertiary bg-surface-secondary py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col items-center gap-6">
      <!-- Social Icons -->
      <div class="flex items-center gap-4">
        {
          social.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg p-2 text-on-surface-tertiary transition-colors hover:bg-surface-tertiary hover:text-primary-500"
              aria-label={item.name}
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={socialIcons[item.icon] || ''} />
              </svg>
            </a>
          ))
        }
      </div>

      <!-- Copyright -->
      <p class="text-sm text-on-surface-tertiary">
        &copy; {currentYear} Laplusdestiny. All rights reserved.
      </p>
    </div>
  </div>
</footer>
