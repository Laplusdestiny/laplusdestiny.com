---
import SocialIcon from './SocialIcon.astro';
import linksData from '../data/links.json';
import { formatDate } from '../lib/format';

interface Props {
  /** データを取得した（＝ビルドした）日時 */
  builtAt: Date;
}

const { builtAt } = Astro.props;
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-5 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <ul class="flex flex-wrap items-center gap-1">
      {
        linksData.links.map((link) => (
          <li>
            <a href={link.url} rel="me noopener" class="block rounded p-2 text-ink-3 transition-colors hover:text-accent" aria-label={link.name}>
              <SocialIcon name={link.icon} class="h-5 w-5" />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="font-mono text-xs leading-relaxed text-ink-3 sm:text-right">
      <p>&copy; {builtAt.getFullYear()} Laplusdestiny</p>
      <p>
        データ取得 <time datetime={builtAt.toISOString()}>{formatDate(builtAt)}</time>（ビルド時）
      </p>
    </div>
  </div>
</footer>
