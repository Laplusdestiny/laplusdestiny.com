---
import MoonIcon from '~icons/lucide/moon';
import SunIcon from '~icons/lucide/sun';
import MenuIcon from '~icons/lucide/menu';
import CloseIcon from '~icons/lucide/x';

interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/75">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5 sm:px-8" aria-label="メイン">
    <a href="/" class="font-semibold tracking-tight">Laplusdestiny</a>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          items.map((item) => (
            <li>
              <a href={item.href} class="rounded px-3 py-2 text-sm text-ink-2 transition-colors hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        data-theme-toggle
        class="rounded p-2 text-ink-2 transition-colors hover:text-accent"
        aria-label="ダークモードに切り替え"
      >
        <MoonIcon class="h-5 w-5 dark:hidden" aria-hidden="true" />
        <SunIcon class="hidden h-5 w-5 dark:block" aria-hidden="true" />
      </button>

      <button
        type="button"
        id="menu-button"
        class="rounded p-2 text-ink-2 transition-colors hover:text-accent md:hidden"
        aria-label="メニュー"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <MenuIcon class="menu-open h-5 w-5" aria-hidden="true" />
        <CloseIcon class="menu-close hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </nav>

  <ul id="mobile-menu" class="hidden border-t border-line px-5 py-2 md:hidden">
    {
      items.map((item) => (
        <li>
          <a href={item.href} class="block py-2.5 text-ink-2 hover:text-accent">
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function syncThemeLabel() {
    const dark = root.classList.contains('dark');
    themeButton?.setAttribute('aria-label', dark ? 'ライトモードに切り替え' : 'ダークモードに切り替え');
  }

  syncThemeLabel();
  themeButton?.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
    syncThemeLabel();
  });

  const menuButton = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  function setMenu(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.querySelector('.menu-open')?.classList.toggle('hidden', open);
    menuButton?.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  }

  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>
