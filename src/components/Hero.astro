---
import { Image } from 'astro:assets';
import MapPinIcon from '~icons/lucide/map-pin';
import logo from '../assets/logo.png';
import profile from '../data/profile.json';

export interface Stat {
  label: string;
  value: string;
  note?: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="graph-paper pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-5xl px-5 pt-14 pb-16 sm:px-8 sm:pt-24 sm:pb-20">
    <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-2xl">
        <p class="font-mono text-xs tracking-wide text-ink-3">{profile.roles.join(' / ')}</p>
        <h1 id="hero-title" class="mt-3 text-4xl font-semibold tracking-tight sm:text-6xl">{profile.name}</h1>
        <div class="mt-6 space-y-2 leading-relaxed text-ink-2 sm:text-lg sm:leading-relaxed">
          {profile.bio.map((line) => <p>{line}</p>)}
        </div>
        <p class="mt-6 flex items-center gap-1.5 font-mono text-xs text-ink-3">
          <MapPinIcon class="h-3.5 w-3.5" aria-hidden="true" />
          <span>{profile.location}</span>
        </p>
      </div>

      <Image
        src={logo}
        alt=""
        width={112}
        height={112}
        class="h-20 w-20 shrink-0 rounded-full border border-line bg-white dark:invert sm:h-28 sm:w-28"
      />
    </div>

    {
      stats.length > 0 && (
        <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded border border-line bg-line sm:mt-16 sm:grid-cols-4">
          {stats.map((stat) => (
            <div class="flex flex-col bg-card px-4 py-4 sm:px-5">
              <dt class="text-xs text-ink-3">{stat.label}</dt>
              <dd class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">{stat.value}</dd>
              {stat.note && <dd class="mt-1 font-mono text-xs text-ink-3">{stat.note}</dd>}
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
