---
import ArrowUpRightIcon from '~icons/lucide/arrow-up-right';
import SectionHeading from './SectionHeading.astro';
import SocialIcon from './SocialIcon.astro';
import linksData from '../data/links.json';

const { links } = linksData;
---

<section id="links" aria-labelledby="links-title" class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
  <SectionHeading id="links-title" label="Elsewhere" meta={`${links.length} links`} title="ほかの場所" />

  <ul class="border-b border-line">
    {
      links.map((link) => (
        <li class="border-t border-line">
          <a
            href={link.url}
            rel="me noopener"
            class="group grid grid-cols-[1.25rem_1fr_auto] items-center gap-x-4 gap-y-1 py-4 sm:grid-cols-[1.25rem_9rem_1fr_auto]"
          >
            <SocialIcon name={link.icon} class="h-5 w-5 text-ink-2 group-hover:text-accent" />
            <span class="font-semibold group-hover:text-accent">{link.name}</span>
            <span class="col-start-2 row-start-2 text-sm text-ink-2 sm:col-start-auto sm:row-start-auto">
              {link.description}
              <span class="mt-0.5 block font-mono text-xs text-ink-3 sm:mt-0 sm:ml-2 sm:inline">{link.handle}</span>
            </span>
            <ArrowUpRightIcon
              class="col-start-3 row-start-1 h-4 w-4 text-ink-3 transition-transform group-hover:text-accent motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5 sm:col-start-4"
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>
