---
import linksData from '../data/links.json';

// Import Iconify icons
import BlogIcon from '~icons/lucide/book';
import GitHubIcon from '~icons/fa7-brands/github';
import TwitterIcon from '~icons/fa7-brands/twitter';
import KaggleIcon from '~icons/fa7-brands/kaggle';
import BlueSkyIcon from '~icons/fa7-brands/bluesky';

const { links } = linksData;

// Icon components mapping
const iconComponents: Record<string, any> = {
  blog: BlogIcon,
  github: GitHubIcon,
  twitter: TwitterIcon,
  kaggle: KaggleIcon,
  bluesky: BlueSkyIcon,
};

// Custom SVG path for Misskey (no standard icon available)
const misskeyPath = 'M 7.693 5.669 C 7.457 5.668 7.223 5.709 7.001 5.79 C 6.609 5.928 6.286 6.177 6.033 6.534 C 5.791 6.88 5.669 7.266 5.669 7.692 L 5.669 15.267 C 5.669 15.82 5.866 16.299 6.257 16.702 C 6.661 17.094 7.14 17.29 7.693 17.29 C 8.258 17.29 8.736 17.094 9.128 16.702 C 9.532 16.299 9.733 15.82 9.733 15.267 L 9.733 13.889 C 9.738 13.591 10.045 13.67 10.2 13.889 C 10.491 14.393 11.171 14.824 11.826 14.824 C 12.481 14.824 13.14 14.466 13.451 13.889 C 13.569 13.751 13.901 13.514 13.936 13.889 L 13.936 15.267 C 13.936 15.82 14.131 16.299 14.523 16.702 C 14.927 17.094 15.405 17.29 15.959 17.29 C 16.523 17.29 17.002 17.094 17.394 16.702 C 17.798 16.299 17.999 15.82 17.999 15.267 L 17.999 7.692 C 17.999 7.266 17.873 6.88 17.619 6.534 C 17.377 6.176 17.06 5.928 16.668 5.79 C 16.437 5.709 16.207 5.669 15.976 5.669 C 15.354 5.669 14.829 5.911 14.402 6.396 L 12.349 8.798 C 12.303 8.833 12.15 9.097 11.825 9.097 C 11.501 9.097 11.366 8.833 11.32 8.799 L 9.249 6.396 C 8.834 5.911 8.315 5.669 7.693 5.669 Z M 20.487 5.669 C 20.003 5.669 19.588 5.842 19.242 6.188 C 18.908 6.522 18.741 6.932 18.741 7.416 C 18.741 7.9 18.908 8.315 19.242 8.661 C 19.588 8.995 20.003 9.162 20.487 9.162 C 20.971 9.162 21.386 8.995 21.732 8.661 C 22.078 8.315 22.251 7.9 22.251 7.416 C 22.251 6.932 22.078 6.522 21.732 6.188 C 21.386 5.842 20.971 5.669 20.487 5.669 Z M 20.504 9.508 C 20.02 9.508 19.605 9.681 19.259 10.027 C 18.913 10.373 18.741 10.788 18.741 11.272 L 18.741 15.544 C 18.741 16.028 18.913 16.443 19.259 16.789 C 19.605 17.123 20.02 17.29 20.504 17.29 C 20.989 17.29 21.398 17.123 21.732 16.789 C 22.078 16.443 22.251 16.028 22.251 15.544 L 22.251 11.272 C 22.251 10.788 22.078 10.373 21.732 10.027 C 21.398 9.681 20.988 9.508 20.504 9.508 Z';
---
---

<section id="links" class="bg-surface py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2
      class="animate-on-scroll mb-16 text-center text-3xl font-bold tracking-tight sm:text-4xl"
    >
      Links
    </h2>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        links.map((link, index) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`animate-on-scroll delay-${(index % 3) * 100 + 100} group flex items-start gap-4 rounded-xl border border-surface-tertiary bg-surface-secondary p-6 transition-all duration-300 hover:-translate-y-2 hover:border-primary-300 hover:shadow-xl hover:shadow-primary-500/10 dark:hover:border-primary-700`}
          >
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-primary-100 text-primary-600 transition-colors group-hover:bg-primary-500 group-hover:text-white dark:bg-primary-900/50 dark:text-primary-400">
              {link.icon === 'misskey' ? (
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d={misskeyPath} />
                </svg>
              ) : link.icon === 'blog' ? (
                <BlogIcon class="h-6 w-6" />
              ) : link.icon === 'github' ? (
                <GitHubIcon class="h-6 w-6" />
              ) : link.icon === 'twitter' ? (
                <TwitterIcon class="h-6 w-6" />
              ) : link.icon === 'kaggle' ? (
                <KaggleIcon class="h-6 w-6" />
              ) : link.icon === 'bluesky' ? (
                <BlueSkyIcon class="h-6 w-6" />
              ) : (
                <BlogIcon class="h-6 w-6" />
              )}
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <h3 class="font-semibold text-on-surface">{link.name}</h3>
                <svg
                  class="h-4 w-4 text-on-surface-tertiary transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              </div>
              <p class="mt-1 text-sm text-on-surface-secondary">{link.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
