---
import SectionHeading from './SectionHeading.astro';
import skillsData from '../data/skills.json';

const { tiers, categories } = skillsData;
const total = categories.reduce((sum, c) => sum + c.skills.length, 0);
const grid = 'md:grid-cols-[11rem_repeat(3,minmax(0,1fr))]';
---

<section id="skills" aria-labelledby="skills-title" class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
  <SectionHeading id="skills-title" label="Skills" meta={`${total} items`} title="使っている技術" />

  <div class={`hidden gap-x-6 pb-3 font-mono text-xs text-ink-3 md:grid ${grid}`} aria-hidden="true">
    <span>分野</span>
    {tiers.map((tier) => <span>{tier.label}</span>)}
  </div>

  <dl class="border-b border-line">
    {
      categories.map((category) => (
        <div class={`grid gap-x-6 gap-y-2 border-t border-line py-4 ${grid}`}>
          <dt class="font-semibold md:text-sm md:font-normal md:text-ink-2">{category.name}</dt>
          {tiers.map((tier) => {
            const skills = category.skills.filter((s) => s.tier === tier.id);
            return (
              <dd class={skills.length === 0 ? 'max-md:hidden' : ''}>
                <span class="mb-1 block font-mono text-xs text-ink-3 md:sr-only">{tier.label}</span>
                {skills.length > 0 ? (
                  <ul class="flex flex-wrap gap-1.5">
                    {skills.map((skill) => (
                      <li class="rounded border border-line bg-card px-2 py-0.5 text-sm">{skill.name}</li>
                    ))}
                  </ul>
                ) : (
                  <span class="text-sm text-ink-3" aria-label="なし">—</span>
                )}
              </dd>
            );
          })}
        </div>
      ))
    }
  </dl>
</section>
