---
import ArrowRightIcon from '~icons/lucide/arrow-right';
import SectionHeading from './SectionHeading.astro';
import PostsChart from './PostsChart.astro';
import type { Post, QuarterCount } from '../lib/blog';
import { formatDate } from '../lib/format';
import { BLOG_URL } from '../config';

interface Props {
  posts: Post[];
  quarters: QuarterCount[];
}

const { posts, quarters } = Astro.props;
const latest = posts.slice(0, 5);
---

<section id="blog" aria-labelledby="blog-title" class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
  <SectionHeading id="blog-title" label="Blog" meta={`${posts.length} posts`} title="書いたもの" />

  <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <PostsChart quarters={quarters} />

    <div>
      <h3 class="text-sm font-semibold">新しい記事</h3>
      <ol class="mt-3 border-t border-line">
        {
          latest.map((post) => (
            <li class="border-b border-line">
              <a href={post.url} class="group grid gap-1 py-3 sm:grid-cols-[6.5rem_1fr] sm:gap-4">
                <time datetime={post.date.toISOString()} class="font-mono text-xs leading-6 text-ink-3">
                  {formatDate(post.date)}
                </time>
                <span>
                  <span class="block leading-6 group-hover:text-accent">{post.title}</span>
                  {post.tags.length > 0 && (
                    <span class="mt-0.5 block font-mono text-xs text-ink-3">{post.tags.map((tag) => `#${tag}`).join(' ')}</span>
                  )}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <a href={BLOG_URL} class="link mt-5 inline-flex items-center gap-1 text-sm">
        すべての記事をブログで読む
        <ArrowRightIcon class="h-3.5 w-3.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
