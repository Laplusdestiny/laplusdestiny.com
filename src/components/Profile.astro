---
import profile from '../data/profile.json';
---

<section id="about" class="bg-surface-secondary py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2
      class="animate-on-scroll mb-16 text-center text-3xl font-bold tracking-tight sm:text-4xl"
    >
      About Me
    </h2>

    <div class="flex flex-col items-center gap-12 md:flex-row md:gap-16">
      <!-- Avatar -->
      <div class="animate-on-scroll flex-shrink-0">
        <div
          class="h-48 w-48 overflow-hidden rounded-full border-4 border-primary-200 shadow-xl dark:border-primary-800 sm:h-56 sm:w-56"
        >
          <img
            src={profile.avatar}
            alt={`${profile.name} のプロフィール写真`}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Bio -->
      <div class="animate-on-scroll delay-200 flex-1 text-center md:text-left">
        <h3 class="mb-2 text-2xl font-bold text-on-surface">
          {profile.name}
        </h3>
        <p class="mb-4 text-sm font-medium text-primary-500">
          {profile.title}
        </p>
        <p class="leading-relaxed text-on-surface-secondary">
          {profile.bio}
        </p>
        <div class="mt-6 flex items-center justify-center gap-2 text-sm text-on-surface-tertiary md:justify-start">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
            ></path>
          </svg>
          <span>{profile.location}</span>
        </div>
      </div>
    </div>
  </div>
</section>
